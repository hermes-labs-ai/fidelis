    given-names: "Rolando"
    orcid: "https://orcid.org/0009-0005-4896-1112"
    affiliation: "Hermes Labs"
license: MIT
repository-code: "https://github.com/hermes-labs-ai/fidelis"
version: "0.0.93"
keywords:
  - "agent memory"
  - "zero-LLM retrieval"
  - "local-first"
  - "Claude Code"
  - "verbatim retrieval"
  - "fidelis-memory"
